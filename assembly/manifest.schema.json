{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AddisonJPratt/CAD-ADE/assembly/manifest.schema.json",
  "title": "Assembly manifest",
  "description": "The one derived file per assembly that Studio, the parts list and the instructions generator read. Written by the assembly gate (assembly/manifest.py). All lengths mm, all angles degrees, all positions, axes and quaternions in the assembly frame. Cross-references (parents, joints, steps, parts list) are checked by assembly.manifest.validate, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "units", "angle_units", "pass", "gate", "disclaimer", "params",
               "provenance", "instances", "joints", "explode", "steps", "bom", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/ident"},
    "name": {"type": "string", "minLength": 1},
    "units": {"const": "mm"},
    "angle_units": {"const": "deg"},
    "pass": {"type": "boolean", "description": "Whether the assembly gate passed. A failing assembly still gets a manifest so Studio can show what is wrong."},
    "gate": {"enum": ["PASS", "FAIL"]},
    "disclaimer": {"type": "string", "minLength": 1},
    "params": {"type": "object", "additionalProperties": {"type": "number"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assembly_file", "sources", "physical_assembly_tested"],
      "properties": {
        "assembly_file": {"type": "string", "minLength": 1},
        "sources": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "description": "sha256 of the assembly file and every printed part's design, by project-relative path."},
        "physical_assembly_tested": {"type": "boolean"}
      }
    },
    "instances": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instance"}},
    "joints": {"type": "array", "items": {"$ref": "#/$defs/joint"}},
    "explode": {"type": "array", "items": {"$ref": "#/$defs/explode"}},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "bom": {"type": "array", "items": {"$ref": "#/$defs/bomRow"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "ident": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "source", "parent", "transform", "mesh"],
      "properties": {
        "id": {"$ref": "#/$defs/ident"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["printed", "hardware", "component"]},
        "source": {"type": "string", "minLength": 1, "description": "designs/<x>.py[#part], library/standard_parts.json#<table>/<size>, or catalogue:<id>."},
        "parent": {"oneOf": [{"$ref": "#/$defs/ident"}, {"type": "null"}]},
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "quaternion"],
          "properties": {
            "position": {"$ref": "#/$defs/vec3"},
            "quaternion": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4,
                           "description": "[x, y, z, w], three.js order; unit length."}
          }
        },
        "mesh": {"type": "string", "pattern": "\\.stl$", "description": "Path relative to the manifest; the mesh is in the instance's local frame."}
      }
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "parent", "child", "origin", "axis", "rest", "range"],
      "properties": {
        "id": {"$ref": "#/$defs/ident"},
        "type": {"enum": ["fixed", "revolute", "prismatic"]},
        "role": {"enum": ["fastener", "press", "clamp"]},
        "parent": {"$ref": "#/$defs/ident"},
        "child": {"$ref": "#/$defs/ident"},
        "origin": {"$ref": "#/$defs/vec3"},
        "axis": {"$ref": "#/$defs/vec3"},
        "rest": {"type": "number", "description": "Assembled joint value: mm for prismatic, degrees for revolute."},
        "range": {"oneOf": [{"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, {"type": "null"}],
                  "description": "[min, max] travel; null until motion is declared (#30)."}
      }
    },
    "explode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance", "direction", "distance", "offset"],
      "properties": {
        "instance": {"$ref": "#/$defs/ident"},
        "direction": {"$ref": "#/$defs/vec3"},
        "distance": {"type": "number", "minimum": 0},
        "offset": {"$ref": "#/$defs/vec3", "description": "Full-explode displacement including every ancestor's; Studio scales it by 0..1."}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "text", "part_ids", "joints", "tool", "callout"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1},
        "part_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ident"}},
        "joints": {"type": "array", "items": {"$ref": "#/$defs/ident"}},
        "tool": {"type": ["string", "null"]},
        "callout": {"type": ["string", "null"]}
      }
    },
    "bomRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "specification", "source", "part_ids", "quantity"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "specification": {"type": "string", "description": "What to buy or print, e.g. 'ISO 4762 socket head cap screw, M3, 12 mm under the head'."},
        "category": {"enum": ["Printed part", "Hardware", "Purchased component"]},
        "source": {"type": "string"},
        "part_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ident"}},
        "quantity": {"type": "integer", "minimum": 1}
      }
    }
  }
}
